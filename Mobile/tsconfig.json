{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@env": ["./env.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
